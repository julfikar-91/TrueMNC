rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isUnder2MB() {
      return request.resource.size < 2 * 1024 * 1024;
    }

    function isPdfOrDocx() {
      return request.resource.contentType in [
        'application/pdf',
        'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
        'application/msword'
      ];
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // ── Resumes ────────────────────────────────────────────────────────────
    // resumes/{uid}/{file}: owner read/delete; owner write only if size < 2MB and contentType is PDF or DOCX.
    match /resumes/{uid}/{file} {
      allow read, delete: if isOwner(uid);
      allow write: if isOwner(uid) && isUnder2MB() && isPdfOrDocx();
    }

    // ── Avatars ────────────────────────────────────────────────────────────
    // avatars/{uid}/{file}: public read; owner write, size < 2MB, image/*.
    match /avatars/{uid}/{file} {
      allow read: if true;
      allow write: if isOwner(uid) && isUnder2MB() && isImage();
    }

    // ── Reports ────────────────────────────────────────────────────────────
    // reports/{uid}/{file}: owner write; read false.
    match /reports/{uid}/{file} {
      allow write: if isOwner(uid);
      allow read: if false;
    }

    // ── Deny by default ────────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

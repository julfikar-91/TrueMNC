rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ───────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role in ['ADMIN', 'SUPER_ADMIN'];
    }

    // ── Jobs ───────────────────────────────────────────────────────────────
    // jobs/{id}: read if (status == 'ACTIVE' && verification.state == 'VERIFIED') || isAdmin(); write false.
    match /jobs/{id} {
      allow read: if (resource.data.status == 'ACTIVE' && resource.data.verification.state == 'VERIFIED') || isAdmin();
      allow write: if false;
    }

    // ── Companies ──────────────────────────────────────────────────────────
    // companies/{id}: read true; write false.
    match /companies/{id} {
      allow read: if true;
      allow write: if false;
    }

    // ── Users ──────────────────────────────────────────────────────────────
    // users/{uid}: read owner or admin;
    // create owner only and must NOT contain 'role';
    // update owner only and must NOT touch role, profile_confirmed_by_system, profile_completion, matchKeys.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && !('role' in request.resource.data);
      allow update: if isOwner(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'role',
        'profile_confirmed_by_system',
        'profile_completion',
        'matchKeys'
      ]);
      allow delete: if false;

      // users/{uid}/recommendations/{jobId}: owner read; write false.
      match /recommendations/{jobId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // users/{uid}/{sub}/{doc}: owner read/write.
      match /{sub}/{doc} {
        allow read, write: if isOwner(uid) && sub != 'recommendations';
      }
    }

    // ── Audit Logs ─────────────────────────────────────────────────────────
    // auditLogs: admin read; write false.
    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Sources ─────────────────────────────────────────────────────────────
    // sources: admin read; write false (server only via admin callables).
    match /sources/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /companies/{companyId}/sources/{sourceId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Collection Runs ─────────────────────────────────────────────────────
    // collectionRuns: admin read; write false.
    match /collectionRuns/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Deny by default ────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

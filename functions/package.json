{
  "name": "truemnc-functions",
  "version": "1.0.0",
  "description": "TrueMNC Cloud Functions Gen 2 – TypeScript, asia-south1",
  "engines": { "node": "20" },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint --ext .ts src/",
    "lint:fix": "eslint --ext .ts src/ --fix",
    "test": "npm run build && node --test lib/__tests__/**/*.test.js",
    "test:rules": "npm run build && node --test lib/__tests__/securityRules.test.js",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "bootstrap": "ts-node scripts/bootstrapSuperAdmin.ts",
    "seed": "ts-node scripts/seedAll.ts",
    "seed:categories": "ts-node scripts/seedCategories.ts",
    "seed:config": "ts-node scripts/seedConfig.ts",
    "seed:stats": "ts-node scripts/seedStats.ts",
    "test:skills": "npm run build && node --test lib/__tests__/skills.test.js",
    "test:resume": "ts-node src/__tests__/resumePipeline.test.ts"
  },
  "dependencies": {
    "firebase-admin": "^12.1.0",
    "firebase-functions": "^5.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.3",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "eslint-config-google": "^0.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  },
  "private": true
}
